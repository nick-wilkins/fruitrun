{
  "name": "fruitrun",
  "version": "1.0.0",
  "description": "Smoothie Scramble: a kids marble-run smoothie game",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:play": "tsc --noEmit && vite build --config vite.play.config.ts",
    "dev:play": "vite --config vite.play.config.ts",
    "preview": "vite preview --host",
    "start": "node server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios": "npm run build && cap sync ios"
  },
  "type": "module",
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "three": "^0.187.0"
  },
  "private": true
}
