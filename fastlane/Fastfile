require 'json'

ROOT = File.expand_path('..', __dir__)
PROJECT = File.join(ROOT, 'ios/App/App.xcodeproj')
PBXPROJ = File.join(PROJECT, 'project.pbxproj')
PACKAGE_JSON = File.join(ROOT, 'package.json')
BUNDLE = 'com.smoothiescramble.app'

def current_version
  JSON.parse(File.read(PACKAGE_JSON))['version']
end

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_filepath: File.expand_path(ENV.fetch('ASC_KEY_PATH'))
  )
end

def build_web
  sh("cd #{ROOT} && npm run build && env -u GEM_HOME -u GEM_PATH -u RUBYOPT -u RUBYLIB -u BUNDLE_GEMFILE npx cap sync ios")
end

# Signing with the key lets the build fetch its own certificate and profile, with no account signed in to Xcode.
def signing_args
  return '-allowProvisioningUpdates' unless ENV['ASC_KEY_ID']

  [
    '-allowProvisioningUpdates',
    "-authenticationKeyPath #{File.expand_path(ENV.fetch('ASC_KEY_PATH'))}",
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
  ].join(' ')
end

# The archive signs itself for development. The store copy is signed on export with the distribution
# certificate in this Mac's keychain and a store profile fetched (or made, the first time) with the key.
def store_export
  return { method: 'app-store' } unless ENV['ASC_KEY_ID']

  asc_key
  get_provisioning_profile(app_identifier: BUNDLE, output_path: File.join(ROOT, 'build'), filename: 'store.mobileprovision')
  {
    method: 'app-store',
    signingStyle: 'manual',
    provisioningProfiles: { BUNDLE => lane_context[SharedValues::SIGH_NAME] }
  }
end

def build_ios
  build_app(
    project: PROJECT,
    scheme: 'App',
    configuration: 'Release',
    export_options: store_export,
    output_directory: File.join(ROOT, 'build'),
    output_name: "SmoothieScramble-#{current_version}.ipa",
    xcargs: signing_args
  )
end

# What the store listing is made from: the words in fastlane/metadata and the pictures in fastlane/screenshots.
# The in-app purchase cannot be checked with the key, so the check before submitting is left to Apple.
def listing
  {
    api_key: asc_key,
    app_identifier: BUNDLE,
    app_version: current_version,
    metadata_path: File.join(ROOT, 'fastlane/metadata'),
    screenshots_path: File.join(ROOT, 'fastlane/screenshots'),
    force: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false
  }
end

desc 'Set the version and add one to the build number. bump version:1.0.0'
lane :bump do |options|
  version = options[:version] || UI.user_error!('Pass version:x.y.z')

  sh("cd #{ROOT} && npm version #{version} --no-git-tag-version --allow-same-version")

  pbx = File.read(PBXPROJ)
  build = pbx[/CURRENT_PROJECT_VERSION = (\d+);/, 1].to_i + 1
  pbx = pbx.gsub(/MARKETING_VERSION = [^;]+;/, "MARKETING_VERSION = #{version};")
           .gsub(/CURRENT_PROJECT_VERSION = \d+;/, "CURRENT_PROJECT_VERSION = #{build};")
  File.write(PBXPROJ, pbx)

  UI.success("#{version}: build #{build}")
end

platform :ios do
  desc 'Build and archive without uploading, to prove the app signs'
  lane :archive do
    build_web
    build_ios
  end

  desc 'Send the words and screenshots to the store listing. Nothing is built and nothing is submitted'
  lane :listing do
    upload_to_app_store(**listing, skip_binary_upload: true, overwrite_screenshots: true, submit_for_review: false)
  end

  desc 'Build, upload and submit for review. submit:false uploads without submitting'
  lane :release do |options|
    build_web
    build_ios
    upload_to_app_store(
      **listing,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_screenshots: true,
      submit_for_review: options[:submit].to_s != 'false',
      # Approved builds wait for a button press in App Store Connect rather than going on sale by themselves.
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: true,
        content_rights_has_rights: true
      }
    )
  end

  desc 'Build, archive and upload to TestFlight for testers, with no store submission'
  lane :beta do
    build_web
    build_ios
    upload_to_testflight(ipa: lane_context[SharedValues::IPA_OUTPUT_PATH], skip_waiting_for_build_processing: true)
  end
end
